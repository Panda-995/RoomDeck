# Optional version or digest pin (Linux amd64 / arm64).
# ROOMDECK_IMAGE=ghcr.io/panda-995/roomdeck:latest
# Optional. The default works on the host's LAN address.
# Use the address reachable by ALL participants; never localhost for remote guests.
# BASE_URL=https://roomdeck.example.com
TZ=Asia/Shanghai
# Optional host directory for ALL persistent data (database, photos, files, exports).
# Leave unset to preserve the existing Docker named volume.
# Linux/NAS: create the directory and grant UID/GID 10001 write access first.
# ROOMDECK_DATA_PATH=./data
# Windows example: ROOMDECK_DATA_PATH=G:/RoomDeck/data

# IP reachable by viewers for media. Set the NAS LAN IP for LAN deployments.
# Leave unset only when automatic public-IP discovery is appropriate.
# ROOMDECK_MEDIA_IP=192.168.1.100
# Optional automatic HTTPS: docker compose -f compose.yaml -f compose.https.yaml up -d
# ROOMDECK_DOMAIN=roomdeck.example.com
# BASE_URL=https://roomdeck.example.com
# Optional TURN/TLS for restrictive networks; see docs/SCREEN-SHARING.md.
# ROOMDECK_TURN_DOMAIN=turn.example.com
# ROOMDECK_TURN_CERTS=./deploy/turn-certs
# ROOMDECK_TURN_BIND_IP=203.0.113.11
# ROOMDECK_WEB_BIND_IP=203.0.113.10
