  "dependencies": {
    "@noble/hashes": "2.4.0",
    "livekit-client": "2.22.3",
    "lucide-vue-next": "0.577.0",
    "qrcode": "1.5.4",
    "vue": "3.5.42",
    "vue-i18n": "11.4.10",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vue-tsc": "3.3.11"
  }
}
